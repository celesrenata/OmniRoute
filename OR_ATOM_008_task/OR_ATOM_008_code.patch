+/** A flat (x0,y0,z0, x1,y1,z1, …) list of sampled curve points. */
+export type PointArray = readonly number[];
+
+/** Something that receives a written (x, y, z) — a scratch `number[3]`. */
+export interface Vec3Out {
+  x: number;
+  y: number;
+  z: number;
+}
